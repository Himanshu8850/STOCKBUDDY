# StockBuddy Backend Environment Configuration
# Copy this file to .env and update the values

# Flask Configuration
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development

# Database Configuration
MONGODB_USERNAME=text
MONGODB_PASSWORD=123
MONGODB_HOST=cluster0.stfphmt.mongodb.net
MONGODB_DB=Shares

# API Configuration
API_TIMEOUT=10
CACHE_TIMEOUT=300
RATE_LIMIT=100 per hour

# ML Model Configuration
MODEL_PATH=12_12min(pro3).keras
FEATURE_CACHE_SIZE=128

# Selenium Configuration
WEBDRIVER_TIMEOUT=30
BROWSER_PATH=/usr/bin/brave-browser
HEADLESS_MODE=True

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=stockbuddy.log

# Performance Settings
MAX_WORKERS=4
CONNECTION_POOL_SIZE=10
WAIT_QUEUE_TIMEOUT=5000
